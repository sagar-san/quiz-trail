# Optional external contribution links. Invalid or blank URLs are hidden.
VITE_PAYPAL_URL=
VITE_VENMO_URL=

# Datastore selection. Blank or omitted also defaults safely to local.
VITE_DATA_MODE=local

# Firebase web application configuration. Required only for Firebase modes.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
